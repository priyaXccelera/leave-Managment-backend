# Copy to .env and adjust. docker-compose.yml falls back to these development values when a variable is unset.
# CHANGE JWT_SECRET, INTERNAL_API_KEY and POSTGRES_PASSWORD for any non-local deployment.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Shared security (identity-service + leave-service must use the same JWT_SECRET) ---
JWT_SECRET=change-me-dev-secret-at-least-32-bytes-long-0123456789
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=7
INTERNAL_API_KEY=change-me-internal-key

# --- Gateway ---
GATEWAY_PORT=8000
CORS_ALLOWED_ORIGINS=*

# --- Identity service ---
SEED_PASSWORD=Password@123
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# --- Leave service ---
WEEKEND_DAYS=SATURDAY,SUNDAY
BACKDATE_DAYS=7
ESCALATION_DAYS=3
ESCALATION_CRON=0 0 * * * *
YEAR_END_CRON=0 10 0 1 1 *
MAX_UPLOAD_MB=5
UPLOAD_DIR=/data/uploads

# --- Variables read directly by the services (set by docker-compose; set them yourself for local `java -jar` runs) ---
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity_db
IDENTITY_DB_USER=postgres
IDENTITY_DB_PASSWORD=postgres
LEAVE_DB_URL=jdbc:postgresql://localhost:5432/leave_db
LEAVE_DB_USER=postgres
LEAVE_DB_PASSWORD=postgres
IDENTITY_SERVICE_URL=http://localhost:8081
LEAVE_SERVICE_URL=http://localhost:8082

# --- Test database (mvn verify runs against a REAL PostgreSQL; each service uses its own schema) ---
TEST_DB_URL=jdbc:postgresql://localhost:5432/app
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
